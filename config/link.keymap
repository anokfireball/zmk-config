#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

// Layer indices. A higher index wins; &trans falls through to the layer below.
// MAC (default layer, always active) is the base. WIN sits directly above it and
// only overrides OS-dependent keys; every other position falls through to MAC.
#define L_MAC    0
#define L_WIN    1
#define L_LOWER  2
#define L_RAISE  3
#define L_SYSTEM 4

#define LINK_MEGA &mega LC(LA(LGUI)) RGUI
#define LINK_STUDIO &studio_unlock
#define LINK_MULT &kp KP_MULTIPLY
#define LINK_BT1 &bt BT_SEL 0
#define LINK_BT2 &bt BT_SEL 1
#define LINK_BT3 &bt BT_SEL 2
#define LINK_BT4 &bt BT_SEL 3
#define LINK_BT5 &bt BT_SEL 4

// Caps Word as close to the QMK boards as stock ZMK v0.3 allows. Letters are shifted;
// digits, Backspace, Delete and minus keep it on, with or without either Shift, so
// `_` (Shift + minus) continues as on QMK. Any other key ends it.
// Not reproducible without a ZMK fork: QMK shifts a plain `-` to `_`
// (and CAPS_WORD_INVERT_ON_SHIFT unshifts letters and `-`), ends Caps Word on
// Ctrl/Alt/GUI chords and after 5 s idle.
&caps_word {
    continue-list = <MINUS BACKSPACE DELETE>;
};

/ {
    behaviors {
        // QMK MEGA: tap = right Cmd, hold = Ctrl+Alt+Cmd. Param order matches
        // `&mt` (hold first, tap second); hold-preferred with a long term so
        // the tap still fires reliably on a quick press.
        mega: mega {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;
        };

        // QMK SLP: lock the host. Single modifier-chord keycodes, so the host
        // sees a real chord. Left SYSTEM key locks macOS, right one locks Windows.
        lock_win: lock_win {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(L)>;
        };
        lock_mac: lock_mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(LG(Q))>;
        };
    };

    combos {
        compatible = "zmk,combos";

        // Both Shifts together turn on Caps Word (QMK: BOTH_SHIFTS_TURNS_ON_CAPS_WORD).
        combo_caps_word {
            bindings = <&caps_word>;
            key-positions = <36 49>;
            timeout-ms = <30>;
            require-prior-idle-ms = <150>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // Default layer. Mac modifier order: Ctrl, Option, Cmd on the left thumbs, mirrored on
        // the right, where the innermost key is MEGA (tap = right Cmd, hold = Ctrl+Option+Cmd).
        mac_layer {
            display-name = "MAC";
// |      `      |      1      |      2      |      3      |      4      |      5      |                                                                     |      6      |      7      |      8      |      9      |      0      |      -      |
// |     TAB     |      Q      |      W      |      E      |      R      |      T      |                                                                     |      Y      |      U      |      I      |      O      |      P      |    BKSPC    |
// |     ESC     |      A      |      S      |      D      |      F      |      G      |                                                                     |      H      |      J      |      K      |      L      |      ;      |      '      |
// |    SHIFT    |      Z      |      X      |      C      |      V      |      B      |    MUTE     |                                         |    PLAY     |      N      |      M      |      ,      |      .      |      /      |    SHIFT    |
//                             |    LCTL     |     ALT     |    LGUI     |    LOWER    |    ENTER    |                                         |    SPACE    |    RAISE    |    MEGA     |    RALT     |    RCTL     |
            bindings =
     <&kp GRAVE> ,  <&kp N1>   ,  <&kp N2>   ,  <&kp N3>   ,  <&kp N4>   ,  <&kp N5>   ,                                                                        <&kp N6>   ,  <&kp N7>   ,  <&kp N8>   ,  <&kp N9>   ,  <&kp N0>   , <&kp MINUS> ,
      <&kp TAB>  ,   <&kp Q>   ,   <&kp W>   ,   <&kp E>   ,   <&kp R>   ,   <&kp T>   ,                                                                         <&kp Y>   ,   <&kp U>   ,   <&kp I>   ,   <&kp O>   ,   <&kp P>   , <&kp BSPC>  ,
      <&kp ESC>  ,   <&kp A>   ,   <&kp S>   ,   <&kp D>   ,   <&kp F>   ,   <&kp G>   ,                                                                         <&kp H>   ,   <&kp J>   ,   <&kp K>   ,   <&kp L>   , <&kp SEMI>  , <&kp APOS>  ,
     <&kp LSHFT> ,   <&kp Z>   ,   <&kp X>   ,   <&kp C>   ,   <&kp V>   ,   <&kp B>   ,<&kp C_MUTE> ,                                           <&kp C_PP>  ,   <&kp N>   ,   <&kp M>   , <&kp COMMA> ,  <&kp DOT>  , <&kp FSLH>  , <&kp RSHFT> ,
                                 <&kp LCTRL> , <&kp LALT>  , <&kp LGUI>  ,<&mo L_LOWER>,  <&kp RET>  ,                                           <&kp SPACE> ,<&mo L_RAISE>, <LINK_MEGA> , <&kp RALT>  , <&kp RCTRL> ;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp PG_DN PG_UP>;
        };

        // Toggled on top of MAC for Windows/Linux. Only OS-dependent keys are overridden:
        // GUI outermost, Ctrl innermost on the thumbs. Everything else falls through to MAC.
        win_layer {
            display-name = "WIN";
// |             |             |             |             |             |             |                                                                     |             |             |             |             |             |             |
// |             |             |             |             |             |             |                                                                     |             |             |             |             |             |             |
// |             |             |             |             |             |             |                                                                     |             |             |             |             |             |             |
// |             |             |             |             |             |             |             |                                         |             |             |             |             |             |             |             |
//                             |    LGUI     |             |    LCTL     |             |             |                                         |             |             |    RCTL     |             |    RGUI     |
            bindings =
      <&trans>   ,  <&trans>   ,  <&trans>   ,  <&trans>   ,  <&trans>   ,  <&trans>   ,                                                                        <&trans>   ,  <&trans>   ,  <&trans>   ,  <&trans>   ,  <&trans>   ,  <&trans>   ,
      <&trans>   ,  <&trans>   ,  <&trans>   ,  <&trans>   ,  <&trans>   ,  <&trans>   ,                                                                        <&trans>   ,  <&trans>   ,  <&trans>   ,  <&trans>   ,  <&trans>   ,  <&trans>   ,
      <&trans>   ,  <&trans>   ,  <&trans>   ,  <&trans>   ,  <&trans>   ,  <&trans>   ,                                                                        <&trans>   ,  <&trans>   ,  <&trans>   ,  <&trans>   ,  <&trans>   ,  <&trans>   ,
      <&trans>   ,  <&trans>   ,  <&trans>   ,  <&trans>   ,  <&trans>   ,  <&trans>   ,  <&trans>   ,                                            <&trans>   ,  <&trans>   ,  <&trans>   ,  <&trans>   ,  <&trans>   ,  <&trans>   ,  <&trans>   ,
                                 <&kp LGUI>  , <&kp LALT>  , <&kp LCTRL> ,  <&trans>   ,  <&trans>   ,                                            <&trans>   ,  <&trans>   , <&kp RCTRL> , <&kp RALT>  , <&kp RGUI>  ;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp PG_DN PG_UP>;
        };

        lower_layer {
            display-name = "SYMBOL";
// |             |     F1      |     F2      |     F3      |     F4      |     F5      |                                                                     |     F6      |     F7      |     F8      |     F9      |     F10     |     F11     |
// |             |      1      |      2      |      3      |      4      |      5      |                                                                     |      6      |      7      |      8      |      9      |      0      |     F12     |
// |             |      !      |      @      |      #      |      $      |      %      |                                                                     |      ^      |      &      |      *      |      (      |      )      |      |      |
// |             |      =      |      -      |      +      |      {      |      }      |             |                                         |             |      [      |      ]      |      ;      |      :      |      \      |             |
//                             |             |             |             |             |  ST.ULOCK   |                                         |             |             |             |             |             |
            bindings =
      <&trans>   ,  <&kp F1>   ,  <&kp F2>   ,  <&kp F3>   ,  <&kp F4>   ,  <&kp F5>   ,                                                                        <&kp F6>   ,  <&kp F7>   ,  <&kp F8>   ,  <&kp F9>   ,  <&kp F10>  ,  <&kp F11>  ,
      <&trans>   ,  <&kp N1>   ,  <&kp N2>   ,  <&kp N3>   ,  <&kp N4>   ,  <&kp N5>   ,                                                                        <&kp N6>   ,  <&kp N7>   ,  <&kp N8>   ,  <&kp N9>   ,  <&kp N0>   ,  <&kp F12>  ,
      <&trans>   , <&kp EXCL>  ,  <&kp AT>   , <&kp HASH>  , <&kp DLLR>  , <&kp PRCNT> ,                                                                       <&kp CARET> , <&kp AMPS>  , <LINK_MULT> , <&kp LPAR>  , <&kp RPAR>  , <&kp PIPE>  ,
      <&trans>   , <&kp EQUAL> , <&kp MINUS> , <&kp PLUS>  , <&kp LBRC>  , <&kp RBRC>  ,  <&trans>   ,                                            <&trans>   , <&kp LBKT>  , <&kp RBKT>  , <&kp SEMI>  , <&kp COLON> , <&kp BSLH>  ,  <&trans>   ,
                                  <&trans>   ,  <&trans>   ,  <&trans>   ,  <&trans>   ,<LINK_STUDIO>,                                            <&trans>   ,  <&trans>   ,  <&trans>   ,  <&trans>   ,  <&trans>   ;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp PG_DN PG_UP>;
        };

        // Like Fn+Tab on the QMK boards: RAISE + Tab flips between MAC and WIN.
        raise_layer {
            display-name = "NAV";
// |             |     F1      |     F2      |     F3      |     F4      |     F5      |                                                                     |     F6      |     F7      |     F8      |     F9      |     F10     |             |
// |   TG WIN    |     BT1     |     BT2     |     BT3     |     BT4     |     BT5     |                                                                     |    PGUP     |    HOME     |      ^      |     END     |     INS     |     DEL     |
// |             |             |             |             |             |             |                                                                     |    PGDN     |     <-      |      v      |     ->      |             |             |
// |             |    BTCLR    |             |             |             |             |             |                                         |             |    CAPS     |             |    PREV     |    NEXT     |    PSCR     |             |
//                             |             |             |             |             |             |                                         |             |             |             |             |             |
            bindings =
      <&trans>   ,  <&kp F1>   ,  <&kp F2>   ,  <&kp F3>   ,  <&kp F4>   ,  <&kp F5>   ,                                                                        <&kp F6>   ,  <&kp F7>   ,  <&kp F8>   ,  <&kp F9>   ,  <&kp F10>  ,  <&trans>   ,
    <&tog L_WIN> , <LINK_BT1>  , <LINK_BT2>  , <LINK_BT3>  , <LINK_BT4>  , <LINK_BT5>  ,                                                                       <&kp PGUP>  , <&kp HOME>  ,  <&kp UP>   ,  <&kp END>  ,  <&kp INS>  ,  <&kp DEL>  ,
      <&trans>   ,  <&trans>   ,  <&trans>   ,  <&trans>   ,  <&trans>   ,  <&trans>   ,                                                                       <&kp PGDN>  , <&kp LEFT>  , <&kp DOWN>  , <&kp RIGHT> ,  <&trans>   ,  <&trans>   ,
      <&trans>   ,<&bt BT_CLR> ,  <&trans>   ,  <&trans>   ,  <&trans>   ,  <&trans>   ,  <&trans>   ,                                            <&trans>   , <&kp CAPS>  ,  <&trans>   ,<&kp C_PREV> ,<&kp C_NEXT> , <&kp PSCRN> ,  <&trans>   ,
                                  <&trans>   ,  <&trans>   ,  <&trans>   ,  <&trans>   ,  <&trans>   ,                                            <&trans>   ,  <&trans>   ,  <&trans>   ,  <&trans>   ,  <&trans>   ;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp PG_DN PG_UP>;
        };

        // Active while LOWER and RAISE are both held (see conditional_layers).
        // Reset behaviors act on the half that owns the pressed key: the left half
        // is the central, the right half only responds while connected to it.
        // The two keys in front of the reset corners lock the host: left locks
        // macOS, right locks Windows.
        system_layer {
            display-name = "SYSTEM";
// |   L:BOOT    |    L:RST    |   M:LOCK    |             |             |             |                                                                     |             |             |             |   W:LOCK    |    R:RST    |   R:BOOT    |
// |             |             |             |             |             |             |                                                                     |             |             |             |             |             |             |
// |             |             |             |             |             |             |                                                                     |             |             |             |             |             |             |
// |             |             |             |             |             |             |             |                                         |             |             |             |             |             |             |             |
//                             |             |             |             |             |             |                                         |             |             |             |             |             |
            bindings =
    <&bootloader>,<&sys_reset> , <&lock_mac> ,  <&trans>   ,  <&trans>   ,  <&trans>   ,                                                                        <&trans>   ,  <&trans>   ,  <&trans>   , <&lock_win> ,<&sys_reset> ,<&bootloader>,
      <&trans>   ,  <&trans>   ,  <&trans>   ,  <&trans>   ,  <&trans>   ,  <&trans>   ,                                                                        <&trans>   ,  <&trans>   ,  <&trans>   ,  <&trans>   ,  <&trans>   ,  <&trans>   ,
      <&trans>   ,  <&trans>   ,  <&trans>   ,  <&trans>   ,  <&trans>   ,  <&trans>   ,                                                                        <&trans>   ,  <&trans>   ,  <&trans>   ,  <&trans>   ,  <&trans>   ,  <&trans>   ,
      <&trans>   ,  <&trans>   ,  <&trans>   ,  <&trans>   ,  <&trans>   ,  <&trans>   ,  <&trans>   ,                                            <&trans>   ,  <&trans>   ,  <&trans>   ,  <&trans>   ,  <&trans>   ,  <&trans>   ,  <&trans>   ,
                                  <&trans>   ,  <&trans>   ,  <&trans>   ,  <&trans>   ,  <&trans>   ,                                            <&trans>   ,  <&trans>   ,  <&trans>   ,  <&trans>   ,  <&trans>   ;
        };
    };
};

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";

        system_tri_layer {
            if-layers = <L_LOWER L_RAISE>;
            then-layer = <L_SYSTEM>;
        };
    };
};
